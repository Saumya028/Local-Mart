# Copy to .env.local for local development. Never commit .env.local itself.

NEXT_PUBLIC_API_URL=http://localhost:8000

# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Razorpay: no env var needed here — the backend returns razorpay_key_id (a
# public, non-secret value) with each sponsorship/banner checkout.

# Optional error tracking (leave blank to disable). From Sentry -> Project
# Settings -> Client Keys. On Vercel, set it in Project -> Settings -> Environment Variables.
NEXT_PUBLIC_SENTRY_DSN=
