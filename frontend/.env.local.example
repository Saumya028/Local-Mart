# Copy to .env.local for local development. Never commit .env.local itself.

NEXT_PUBLIC_API_URL=http://localhost:8000

# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# No Razorpay env var needed here — the backend's POST /orders response
# already includes razorpay_key_id (Razorpay's key ID is a public,
# non-secret value, safe to hand to the browser per-checkout).
