# Copy this file to `.env` and fill in real values. Never commit `.env` itself.

ENVIRONMENT=development

# From Supabase: Project Settings -> Database -> Connection string (URI)
# Use the "Transaction pooler" or "Session pooler" string, and note it
# needs the +asyncpg driver prefix added, e.g.:
# postgresql+asyncpg://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres

# From Upstash: Database -> Details -> "Redis Connect" (use the rediss:// TLS URL in production)
REDIS_URL=redis://default:password@localhost:6379

# From Supabase: Project Settings -> API -> Project URL
# Needed to fetch Supabase's public JWKS keys for token verification.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# From Supabase: Project Settings -> API -> JWT Settings -> "Legacy JWT Secret"
# Only used if your project still signs tokens with HS256 (older projects).
# Newer projects sign with ES256 and verify via SUPABASE_URL's JWKS instead —
# in that case this can be left blank, our code detects which scheme to use
# automatically from each token.
SUPABASE_JWT_SECRET=

# From Razorpay Dashboard -> Settings -> API Keys (test mode, starts with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-key-secret

# From Razorpay Dashboard -> Settings -> Webhooks -> the webhook's "Secret"
# (set this when you register https://your-api/webhooks/razorpay there)
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# The frontend's origin, for CORS
FRONTEND_ORIGIN=http://localhost:3000
