# Copy this file to `.env` and fill in real values. Never commit `.env` itself.

ENVIRONMENT=development

# From Supabase: Project Settings -> Database -> Connection string (URI)
# Use the "Transaction pooler" or "Session pooler" string, and note it
# needs the +asyncpg driver prefix added, e.g.:
# postgresql+asyncpg://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres

# From Upstash: Database -> Details -> "Redis Connect" (use the rediss:// TLS URL in production)
REDIS_URL=redis://default:password@localhost:6379

# From Supabase: Project Settings -> API -> Project URL
# Needed to fetch Supabase's public JWKS keys for token verification.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# From Supabase: Project Settings -> API -> Project API keys -> "service_role" (secret)
# ONLY needed for the Shop Dashboard's Staff tab (creating manager/delivery
# logins on an owner's behalf) — see backend/app/core/supabase_admin.py.
# Never expose this to the frontend or commit it; leave blank if you're not
# using staff accounts yet, and that one feature will return a clear error
# instead of silently working.
SUPABASE_SERVICE_ROLE_KEY=

# From Supabase: Project Settings -> API -> JWT Settings -> "Legacy JWT Secret"
# Only used if your project still signs tokens with HS256 (older projects).
# Newer projects sign with ES256 and verify via SUPABASE_URL's JWKS instead —
# in that case this can be left blank, our code detects which scheme to use
# automatically from each token.
SUPABASE_JWT_SECRET=

# The frontend's origin(s), for CORS. Comma-separated if you need more
# than one (e.g. a staging AND a prod frontend calling the same API) —
# see core/config.py's `cors_origins` property.
FRONTEND_ORIGIN=http://localhost:3000

# Phase 7 — observability. Leave SENTRY_DSN blank to run with error
# tracking off entirely (the default — nothing here requires a Sentry
# account). Get a DSN from Sentry -> Project Settings -> Client Keys.
SENTRY_DSN=
LOG_LEVEL=INFO

# Shop promotion (sponsorship) payments. Leave empty in local dev to use the
# no-money TEST mode; in production these are required (buying is disabled
# without them).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Recommendations (all optional; defaults shown) ----------------------
# RECO_ENABLED=true
# RECO_HOLDOUT_PCT=0             # % of logged-in users kept on the baseline as a control group (0-50)
# RECO_MIN_CO_BUYERS=3
# RECO_HALF_LIFE_DAYS=90
# RECO_EXCLUDED_CATEGORIES=Pharmacy   # comma-separated; never recommended across customers
# RECO_EVENT_RETENTION_DAYS=90
# RECO_STALE_HOURS=36

# ---- Order expiry (scripts/expire_unpaid_orders.py, run every ~15 min) ------
# ORDER_UNPAID_UPI_EXPIRY_MINUTES=120   # unpaid UPI order is cancelled + stock released after this
# ORDER_UNACTED_EXPIRY_HOURS=24         # order the shop never started (and nobody paid) is cancelled after this

# ---- Reverse proxy (needed for correct per-IP rate limiting) -----------------
# Number of proxies in front of this app that append to X-Forwarded-For.
# Railway / Render / Fly / Heroku: 1.  Directly exposed: 0 (default).
# TRUSTED_PROXY_COUNT=1
